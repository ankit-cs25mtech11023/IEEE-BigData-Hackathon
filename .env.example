# College-hosted OpenAI-compatible endpoint
LLM_BASE_URL=http://HOST:PORT/v1
LLM_API_KEY=changeme
LLM_MODEL=model-name-as-listed-by-/v1/models
# Max parallel requests to the server
LLM_CONCURRENCY=8
# Reasoning ("thinking") mode for the default requests: 0 = off (fast), 1 = on.
# Seen-solver generation always runs with thinking off.
LLM_THINKING=0
# Extra max_tokens granted to a request when thinking is on
LLM_THINK_BUDGET=8192
